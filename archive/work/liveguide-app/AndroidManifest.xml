 <uses-permission android:name="mediatek.permission.ACCESS_APU_SYS"/>
 <uses-feature android:name="android.hardware.camera.any" android:required="true"/>
 <application android:label="Camera" android:icon="@drawable/camera_icon" android:theme="@android:style/Theme.Material.NoActionBar" android:debuggable="true" android:allowBackup="false" android:extractNativeLibs="true">
